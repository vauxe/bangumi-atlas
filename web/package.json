{
  "name": "bangumi-atlas-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "esbuild src/main.ts --bundle --format=esm --splitting --outdir=../site --entry-names=app --chunk-names=chunks/[name]-[hash] --watch=forever & http-server ../site -p 8300 -c-1 --silent",
    "serve:smoke": "http-server ../site -a 127.0.0.1 -p 8391 -c-1 --silent",
    "check": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-dist && node --test .test-dist/*.test.js",
    "smoke": "esbuild tests/smoke.mts --bundle --platform=node --format=esm --outfile=.test-dist/smoke.mjs && node .test-dist/smoke.mjs",
    "bench:frontend": "esbuild bench/frontend-performance.mts --bundle --platform=node --format=esm --outfile=.test-dist/frontend-performance.mjs && node --expose-gc .test-dist/frontend-performance.mjs",
    "bench:query": "esbuild bench/query-performance.mts --bundle --platform=node --format=esm --outfile=.test-dist/query-performance.mjs && node --expose-gc .test-dist/query-performance.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bgm38/wiki": "0.3.3",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@luma.gl/core": "^9.3.6",
    "mjolnir.js": "^3.0.0"
  }
}
